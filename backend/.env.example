# Server
PORT=8000
NODE_ENV=development

# Public URL of this API (used to mint local file-upload URLs in development).
# In production set this to your Railway / droplet origin.
PUBLIC_API_URL=http://localhost:8000

# ── DigitalOcean Managed PostgreSQL ──────────────────────────────────────────
# Databases → cluster → Connection details → Connection string (URI)
# Example: postgresql://doadmin:SECRET@db-xxx.db.ondigitalocean.com:25060/defaultdb?sslmode=require
# Use the direct cluster URI (port 25060), not the connection-pooler port.
# Apply schema:  cd backend && npm run db:setup
DATABASE_URL=postgresql://doadmin:password@your-db.db.ondigitalocean.com:25060/defaultdb?sslmode=require

# Optional instead of DATABASE_URL:
# PGHOST=your-db.db.ondigitalocean.com
# PGPORT=25060
# PGUSER=doadmin
# PGPASSWORD=password
# PGDATABASE=defaultdb

# Set to "disable" only for a local Postgres without TLS.
# DATABASE_SSL=disable

# ── DigitalOcean Spaces (optional — file uploads) ────────────────────────────
# If omitted, files are stored on local disk under backend/uploads.
# DO_SPACES_KEY=your-spaces-key
# DO_SPACES_SECRET=your-spaces-secret
# DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
# DO_SPACES_BUCKET=co-helper
# DO_SPACES_REGION=fra1
# STORAGE_SECRET=a-long-random-string

# Firebase Admin (token verification)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Gemini (server-side "Edit with AI" rewrites — never expose this to the frontend)
GEMINI_API_KEY=your-gemini-api-key

# Trello Power-Up / API key (https://trello.com/power-ups/admin)
# Freelancers authorize their own token in the app; this is the app key only.
TRELLO_API_KEY=your-trello-api-key
# Public app origin used as Trello's return_url after authorize
# TRELLO_RETURN_URL=https://co-helper.com
PUBLIC_APP_URL=https://co-helper.com

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://co-helper.com,https://www.co-helper.com

# Invite + contact emails (optional — tokens still work without it)
# RESEND_API_KEY=re_xxxx
# EMAIL_FROM=Co-Helper <hello@co-helper.com>
# CONTACT_INBOX=hello@co-helper.com
# Secret used to encrypt workspace SMTP passwords (falls back to STORAGE_SECRET)
# APP_SECRET=a-long-random-string
# Optional cron endpoint: POST /internal/billing-tick
# BILLING_TICK_SECRET=a-long-random-string

# Stripe subscription billing (optional)
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_ID=price_xxx
# PUBLIC_APP_URL=https://co-helper.com
